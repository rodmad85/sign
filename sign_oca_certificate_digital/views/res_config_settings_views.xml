<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_certificate" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sign_oca.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sign_oca']" position="inside">
                <block
                    title="Digital Certificate Authentication"
                    name="sign_oca_certificate_digital_settings"
                >
                    <setting>
                        <field name="sign_oca_certificate_required" />
                    </setting>
                    <setting>
                        <field name="sign_oca_certificate_revocation_url" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
